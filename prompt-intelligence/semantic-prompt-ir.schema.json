{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lokal-ai.net/schemas/semantic-prompt-ir.v1.json",
  "title": "LOKAL AI Semantic Prompt IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "input_language",
    "media_type",
    "user_intent",
    "subjects",
    "actions",
    "environment",
    "composition",
    "style",
    "camera",
    "lighting",
    "color_palette",
    "materials",
    "mood",
    "text_elements",
    "constraints",
    "output",
    "ambiguities",
    "assumptions"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "input_language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "design"
      ]
    },
    "user_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "subjects": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "attributes",
          "position",
          "relations"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "maxLength": 80
          },
          "attributes": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "position": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "relations": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor",
          "action",
          "target",
          "timing"
        ],
        "properties": {
          "actor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "action": {
            "type": "string",
            "maxLength": 300
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "timing": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "time",
        "weather",
        "background",
        "details"
      ],
      "properties": {
        "location": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "time": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "weather": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "background": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "details": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "framing",
        "viewpoint",
        "subject_hierarchy",
        "depth"
      ],
      "properties": {
        "layout": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "framing": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "viewpoint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "subject_hierarchy": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "depth": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "style": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot",
        "angle",
        "lens",
        "movement",
        "focus"
      ],
      "properties": {
        "shot": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "angle": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "lens": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "movement": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "focus": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "lighting": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "color_palette": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "materials": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "mood": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "text_elements": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "language",
          "placement",
          "typography"
        ],
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 500
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 35
          },
          "placement": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "typography": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must_include",
        "must_avoid",
        "negative_constraints",
        "preserve_exactly"
      ],
      "properties": {
        "must_include": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "must_avoid": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "negative_constraints": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "preserve_exactly": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "resolution",
        "duration_seconds",
        "frame_rate",
        "format",
        "other_parameters"
      ],
      "properties": {
        "aspect_ratio": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 3600
        },
        "frame_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 240
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "other_parameters": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "value": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "reason",
          "blocks_execution"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "blocks_execution": {
            "type": "boolean"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "basis"
        ],
        "properties": {
          "value": {
            "type": "string",
            "maxLength": 300
          },
          "basis": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
